# UNCP Environment Configuration
# Copy this file to .env and fill in your values

# Gemini API (for scoring)
GEMINI_API_KEY=

# MongoDB
MONGODB_URI=mongodb+srv://...
MONGODB_DB=locust-backend

# Infrastructure
DROPLET_IP=
TARGET_URL=http://dvwa-ip
TARGET_IP=

# Engagement
ENGAGEMENT_ID=

# Solana (optional — on-chain anchoring of attack chains via SPL Memo)
# Generate a keypair: solana-keygen new -o agent-keypair.json
# Fund it on devnet: solana airdrop 1 <PUBKEY> --url devnet
# SOLANA_PROGRAM_ID is reserved for a future Anchor program upgrade
SOLANA_PROGRAM_ID=
AGENT_KEYPAIR_PATH=
SOLANA_RPC_URL=https://api.devnet.solana.com

# Censys API (optional, for recon enrichment)
CENSYS_API_KEY=

# GitHub (optional — required to create issues from attack chains)
# Token needs: repo scope (or issues:write for fine-grained tokens)
# Set github_repo_url on ScopeDocument to enable automatic issue creation
GITHUB_TOKEN=

# Agent Configuration
LOG_LEVEL=INFO
AGENT_RECON_MODE=real
AGENT_EXPLOIT_MODE=real
AGENT_LATERAL_MODE=real
